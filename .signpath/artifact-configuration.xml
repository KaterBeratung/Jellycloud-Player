<?xml version="1.0" encoding="utf-8"?>
<!--
  Artefakt-Konfiguration fuer SignPath (Projekt "Jellycloud Player"): in SignPath unter Project > Artifact Configurations einfuegen.
  Der Workflow .github/workflows/windows-release.yml laedt den unsignierten Installer als GitHub-Artefakt hoch (ein ZIP mit genau einer Datei);
  signiert wird der Installer selbst (Authenticode). Das mitgelieferte mpv bleibt, wie es vom Projekt kommt.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Jellycloud-Player-Setup-*.exe" max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
